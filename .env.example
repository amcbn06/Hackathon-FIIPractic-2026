# Copy this file to .env and fill in real values. Never commit .env.
# Every variable is optional except JWT_SECRET — the app degrades gracefully.

# ----- Core ----------------------------------------------------------------

# JWT signing secret. Generate one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=replace_with_a_random_hex_string

# How long a login token stays valid (hours).
JWT_TTL_HOURS=168

# SQLite by default; point at Postgres etc. for production.
# DATABASE_URL=sqlite:///./onepick.db

# Comma-separated emails granted admin powers (approve/reject/delete places).
ADMIN_EMAILS=demo@onepick.app

# ----- Recommendations -----------------------------------------------------

# Max rerolls a user gets per day.
DAILY_REROLL_LIMIT=3

# Community upvotes a pending place needs to auto-promote to "approved".
PLACE_PROMOTION_VOTES=3

# ----- AI (optional, off by default) ---------------------------------------

# Set to "true" to enable Claude-generated "why this pick" reasons.
USE_ANTHROPIC=false
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# ----- CORS ----------------------------------------------------------------

# Comma-separated allowed origins for the API. "*" is fine for local dev.
CORS_ORIGINS=*
